# ---------- Base de dados ----------
DB_NAME=clinica
DB_USER=clinica
DB_PASSWORD=mudar_isto
DB_ROOT_PASSWORD=mudar_isto
# na vm1 a base de dados está no container "db"; na vm2 usar o IP da vm1 (192.168.56.11)
DB_HOST=db
DB_PORT=3306
# vm1 ou vm2: aparece em /api/health e serve para provar o balanceamento
VM_NAME=vm1

# ---------- Rede ----------
VM1_IP=192.168.56.11
VM2_IP=192.168.56.12
VIP=192.168.56.10

# ---------- Keepalived ----------
VRRP_PASSWORD=mudar123

# ---------- Redis ----------
REDIS_HOST=192.168.56.11
REDIS_PORT=6379
REDIS_PASSWORD=mudar123

# ---------- API (backend Node) ----------
API_PORT=3000
NODE_ENV=production
# migrações só na vm1
RUN_MIGRATIONS=true
# sessões em Redis usam SESSION_SECRET; se escolheremos JWT usam JWT_SECRET
SESSION_SECRET=mudar_isto
JWT_SECRET=mudar_isto

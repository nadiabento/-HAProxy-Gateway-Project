# ---------- Base de dados (primário na vm3) ----------
DB_NAME=clinica
DB_USER=clinica
DB_PASSWORD=mudar
DB_ROOT_PASSWORD=mudar
# Primário: onde o Sequelize escreve e corre as migrações
DB_HOST=192.168.56.13
DB_PORT=3306
# Réplica na vm2 (leitura ou contingência)
DB_REPLICA_HOST=192.168.56.12
DB_REPLICA_PORT=3306
# vm1 ou vm2: aparece em /api/health e prova o balanceamento
VM_NAME=vm1

# ---------- Rede ----------
VM1_IP=192.168.56.11
VM2_IP=192.168.56.12
VM3_IP=192.168.56.13
VIP=192.168.56.10

# ---------- Keepalived ----------
VRRP_PASSWORD=mudar

# ---------- Redis (primário na vm1, réplica na vm2) ----------
REDIS_HOST=192.168.56.11
REDIS_PORT=6379
REDIS_PASSWORD=mudar

# ---------- API (backend Node.js) ----------
API_PORT=3000
NODE_ENV=development

# true = cria as tabelas e os dados de teste ao arrancar (db-init.js). Pode correr várias
# vezes: só cria o que falta.
RUN_MIGRATIONS=true
# chave que assina os tokens de login (gerar com: openssl rand -hex 32)
JWT_SECRET=mudar
JWT_EXPIRES_IN=8h
SESSION_SECRET=mudar

# O servidor da universidade usa outro ficheiro: cloud/.env.cloud (ver cloud/README.md)
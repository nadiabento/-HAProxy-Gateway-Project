# Copiar para .env e ajustar se for preciso. O .env NÃO vai para o Git.

# ---------- Base de dados (primário na vm3) ----------
DB_NAME=clinica
DB_USER=clinica
DB_PASSWORD=Clinica2026!
DB_ROOT_PASSWORD=Clinica2026!
# Primário: onde o Sequelize escreve e corre as migrações
DB_HOST=192.168.56.13
DB_PORT=3306
# Réplica na vm2 (leitura ou contingência)
DB_REPLICA_HOST=192.168.56.12
DB_REPLICA_PORT=3306
# vm1 ou vm2: aparece em /api/health e prova o balanceamento
VM_NAME=vm1

# ---------- Rede ----------
VM1_IP=192.168.56.11
VM2_IP=192.168.56.12
VM3_IP=192.168.56.13
VIP=192.168.56.10

# ---------- Keepalived ----------
VRRP_PASSWORD=mudar123

# ---------- Redis (primário na vm1, réplica na vm2) ----------
REDIS_HOST=192.168.56.11
REDIS_PORT=6379
REDIS_PASSWORD=mudar123

# ---------- API (backend Node.js) ----------
API_PORT=3000
NODE_ENV=development
# Migrações só a partir da vm1
RUN_MIGRATIONS=true
# Login com JWT e sessões em Redis
JWT_SECRET=token_prc_26
JWT_EXPIRES_IN=8h
SESSION_SECRET=sessao_prc_26
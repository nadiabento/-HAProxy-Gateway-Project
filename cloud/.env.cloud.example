# ---------- Acesso por SSH ----------
SSH_USER=mudar
SSH_PORT=22
# chave privada (opcional)
SSH_KEY=

# ---------- Máquinas ----------
# 1 máquina: só SERVIDOR1. 2 máquinas: + SERVIDOR2. 3 máquinas: + SERVIDOR_BD
SERVIDOR1=
SERVIDOR2=
SERVIDOR_BD=

# IP interno de cada máquina (vazio = igual ao de cima)
SERVIDOR1_IP=
SERVIDOR2_IP=
SERVIDOR_BD_IP=

# Endereço que se abre no browser (vazio = SERVIDOR1)
ENTRADA=

# Pastas no servidor, dentro de ~
PASTA_REMOTA=clinica
PASTA_DADOS=dados

# "docker" se o utilizador estiver no grupo docker; "sudo docker" se não estiver
DOCKER=docker

# ---------- Aplicação ----------
DB_NAME=clinica
DB_USER=clinica
DB_PASSWORD=mudar
DB_ROOT_PASSWORD=mudar
# gerar com: openssl rand -hex 32
JWT_SECRET=mudar
JWT_EXPIRES_IN=8h
SESSION_SECRET=
# página de estatísticas do HAProxy (porta 8404)
STATS_USER=admin
STATS_PASSWORD=mudar

# ---------- Cópias de segurança ----------
# sim = cópia diária às 03:00 na máquina da BD
BACKUP_AUTOMATICO=sim

# ---------- Demos ----------
# sim = as demos fazem os pedidos dentro do SERVIDOR1 (se o PC não chegar ao portal)
DEMO_VIA_SSH=nao